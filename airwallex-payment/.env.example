# SQLite
DATABASE_URL="file:./prisma/dev.db"

# App URL (update to ngrok/tunnel URL for webhook testing)
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Airwallex environment: "demo" (sandbox) or "prod"
AIRWALLEX_ENV="demo"

# Airwallex API credentials (Dashboard → Account → API keys)
AIRWALLEX_CLIENT_ID="your_client_id_here"
AIRWALLEX_API_KEY="your_api_key_here"

# Airwallex webhook signing secret (Dashboard → Account → Webhooks)
AIRWALLEX_WEBHOOK_SECRET="whsec_..."

# Frontend: Airwallex environment for @airwallex/components-sdk
NEXT_PUBLIC_AIRWALLEX_ENV="demo"
