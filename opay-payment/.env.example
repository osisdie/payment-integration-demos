# --- Email (SMTP for invoice notifications) ---
# Gmail: use App Password (https://myaccount.google.com/apppasswords)
# SMTP_HOST="smtp.gmail.com"           # Default: smtp.gmail.com
# SMTP_PORT="587"                      # Default: 587
# SMTP_AUTH_USER="you@gmail.com"
# SMTP_APP_PASSWORD=""                # Gmail App Password (16 chars, no spaces)
# SMTP_FROM_EMAIL="you@gmail.com"
# SMTP_FROM_NAME="Your Name"
# SMTP_REPLY_EMAIL="noreply@example.com"
# FALLBACK_EMAIL=""                    # System fallback when customer email fails
