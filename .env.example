# Copy to .env — required for scripts: pnpm stripe:cancel-sub | pnpm stripe:refund-last
# Stripe CLI is installed on your OS (Homebrew / Scoop / apt). See docs/STRIPE_LOCAL_VERIFY.md

# SQLite (path is relative to the prisma/schema.prisma folder)
DATABASE_URL="file:./prisma/dev.db"

# Used in success redirects and Stripe session URLs — no trailing slash
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Dashboard → Developers → API keys → Secret key (test mode)
STRIPE_SECRET_KEY="sk_test_..."

# Printed by `stripe listen` when forwarding webhooks locally
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: Stripe Price ID for one-time Checkout (otherwise inline price_data USD $5.99 is used)
STRIPE_PRICE_ONE_TIME=

# Required for subscription demo: recurring monthly Price ID from your Dashboard
STRIPE_PRICE_SUBSCRIPTION_MONTHLY="price_..."
